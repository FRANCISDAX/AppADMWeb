VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Token de APIS Perú para consultar DNI/RUC (solo fallback/proxy; si usás endpoint propio, no se envía)
VITE_APIS_PERU_TOKEN=
# URL del endpoint propio de consulta SUNAT (p. ej. tu appadm-sunat en AWS Lambda):
# https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
# Si se define, el web consulta ahí y NO envía el token (lo lleva el servidor).
VITE_SUNAT_API_BASE=
# reCAPTCHA v3 site key para App Check (protege Firestore/Storage de abuso).
# Obtener en: https://www.google.com/recaptcha/admin/create
# Si no se define, App Check queda desactivado.
VITE_RECAPTCHA_SITE_KEY=
